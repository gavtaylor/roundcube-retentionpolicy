{
    "name": "gavtaylor/retentionpolicy",
    "type": "roundcube-plugin",
    "description": "Outlook-style per-folder retention policies: automatically delete or archive messages older than a set period, applied nightly on the Dovecot server",
    "keywords": ["roundcube", "roundcubemail", "webmail", "plugin", "retention", "cleanup", "archive", "dovecot", "doveadm", "email"],
    "homepage": "https://github.com/gavtaylor/roundcube-retentionpolicy",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Gavin Taylor",
            "homepage": "https://github.com/gavtaylor"
        }
    ],
    "support": {
        "issues": "https://github.com/gavtaylor/roundcube-retentionpolicy/issues",
        "source": "https://github.com/gavtaylor/roundcube-retentionpolicy"
    },
    "require": {
        "php": ">=8.1.0",
        "roundcube/plugin-installer": "~0.3.5"
    },
    "autoload": {
        "classmap": [
            "retentionpolicy.php",
            "retentionpolicy_engine.php"
        ]
    }
}
